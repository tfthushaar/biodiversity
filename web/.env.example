# Copy to web/.env.local for local dev. These are PUBLIC: they are compiled into the browser bundle.
# Never put a service-role key here.

# The REST API. Supabase: https://YOUR-REF.supabase.co/rest/v1   Local: http://localhost:3000
VITE_REST_URL=http://localhost:3000
# Supabase anon (public) key. Not needed for the local REST API.
VITE_ANON_KEY=
# Optional: the FastAPI service for the live photo demo. Leave empty to hide the demo.
VITE_API_URL=
